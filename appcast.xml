    <!-- Latest release -->
    <item>
      <title>Version 0.3.3</title>
      <link>https://github.com/pingfan-hu/MiniNotes/releases/tag/v0.3.3</link>
      <sparkle:version>0.3.3</sparkle:version>
      <sparkle:shortVersionString>0.3.3</sparkle:shortVersionString>
      <description><![CDATA[
        <h2>What's New</h2>
        <ul>
          <li>Redesigned menu bar icon: an outlined rounded-rect badge with a pen, matching the size and style of the system input method icon.</li>
          <li>The icon inverts to a solid badge while the notes panel is open, just like the input method icon when engaged.</li>
          <li>The icon is now drawn as resolution-independent vector art, so it stays crisp and intact at every display scaling.</li>
        </ul>
      ]]></description>
      <pubDate>Tue, 11 Aug 2026 20:23:03 +0000</pubDate>
      <enclosure
