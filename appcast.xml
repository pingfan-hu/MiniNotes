    <!-- Previous release -->
    <item>
      <title>Version 0.3.2</title>
      <link>https://github.com/pingfan-hu/MiniNotes/releases/tag/v0.3.2</link>
      <sparkle:version>0.3.2</sparkle:version>
      <sparkle:shortVersionString>0.3.2</sparkle:shortVersionString>
      <description><![CDATA[
        <h2>What's New</h2>
        <ul>
          <li>Cursor now follows the system appearance: white in dark mode, black in light mode.</li>
          <li>Thinner text cursor matching Obsidian's caret style.</li>
          <li>Menu bar icon now rescues itself if a menu bar manager (e.g. Ice) pushes it off-screen — checked at launch, on app reopen, and when opening the panel.</li>
        </ul>
      ]]></description>
      <pubDate>Fri, 03 Jul 2026 10:59:45 +0000</pubDate>
      <enclosure
